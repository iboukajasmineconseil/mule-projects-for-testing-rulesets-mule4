<mule xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:apikit="http://www.mulesoft.org/schema/mule/mule-apikit" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns:http="http://www.mulesoft.org/schema/mule/http" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd http://www.mulesoft.org/schema/mule/mule-apikit http://www.mulesoft.org/schema/mule/mule-apikit/current/mule-apikit.xsd http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd ">
    <http:listener-config name="sonar-api1-for-testing-httpListenerConfig">
        <http:listener-connection host="0.0.0.0" port="8081"></http:listener-connection>
    </http:listener-config>
    <apikit:config api="resource::167d12fd-a524-4ceb-9804-cb9e9ac3cdc3:sonar-api1-for-testing:1.0.0:raml:zip:sonar-api1-for-testing.raml" httpStatusVarName="httpStatus" name="sonar-api1-for-testing-config" outboundHeadersMapName="outboundHeaders"></apikit:config>
    <flow name="sonar-api-for-testing-main">
        <http:listener config-ref="sonar-api1-for-testing-httpListenerConfig" path="/api/*">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body>#[payload]</http:body>
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:error-response>
        </http:listener>
        <apikit:router config-ref="sonar-api1-for-testing-config"></apikit:router>
        <error-handler>
            <on-error-propagate doc:name="On-error-propagate" type="HTTP:CONNECTIVITY">
                <logger doc:id="becqbf" doc:name="Logger" message="Hello"></logger>
            </on-error-propagate>
        </error-handler>
    </flow>
    <flow name="sonar-api-for-testing-console">
        <http:listener config-ref="sonar-api1-for-testing-httpListenerConfig" path="/console/*">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body>#[payload]</http:body>
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:error-response>
        </http:listener>
        <apikit:console config-ref="sonar-api1-for-testing-config"></apikit:console>
        <error-handler>
            <on-error-propagate doc:name="On-error-propagate" type="HTTP:CONNECTIVITY">
                <logger doc:id="becqbf" doc:name="Logger" message="Hello"></logger>
            </on-error-propagate>
        </error-handler>
    </flow>
    <flow name="get:\hello:sonar-api-for-testing-config">
        <ee:transform doc:name="Transform Message">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
"Hello Sonar" as String {encoding: "UTF-8", mediaType: "application/json"}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
    </flow>
</mule>
